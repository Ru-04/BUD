# Server-side only. Copy to backend/.env; never put the key in frontend/.env.
GROQ_API_KEY=
# Choose and verify a chat model in your Groq account. No default is assumed.
GROQ_CHAT_MODEL=
# Choose and verify a Whisper model in your Groq account. No default is assumed.
GROQ_WHISPER_MODEL=
# Choose and verify a text-to-speech model in your Groq account. No default is assumed.
GROQ_TTS_MODEL=
FRONTEND_ORIGIN=http://localhost:5173
